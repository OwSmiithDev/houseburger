# Copie para .env e preencha com os dados do seu projeto Supabase.
# O .env está no .gitignore e não vai para o repositório.
#
# ATENÇÃO: só estas duas. A chave `service_role` e a `sb_secret_` ignoram todas
# as regras de acesso e NUNCA podem aparecer aqui — tudo que começa com VITE_
# vai embutido no JavaScript entregue ao navegador.
#
# A chave publicável é pública por design: ela é segura porque supabase/rls.sql
# limita o visitante a apenas ler o catálogo.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
